<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cc="using:AvaloniaEdit.CodeCompletion">

    <!-- 补全弹层的默认样式在浅色主题下会露出黑色边框和滚动条，这里统一成编辑器配色。 -->
    <Style Selector="cc|CompletionList">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#D8DCE3" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="cc|CompletionList /template/ Border">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#D8DCE3" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="cc|CompletionListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4" />
    </Style>

    <Style Selector="cc|CompletionList ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="8" />
    </Style>

    <Style Selector="cc|CompletionList ScrollBar /template/ Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="cc|CompletionList ScrollBar Thumb">
        <Setter Property="Background" Value="#C7CDD6" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style Selector="cc|CompletionList ScrollBar /template/ Thumb">
        <Setter Property="Background" Value="#C7CDD6" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style Selector="cc|CompletionList ScrollBar /template/ Track /template/ Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="cc|CompletionList ScrollBar /template/ Track /template/ Thumb">
        <Setter Property="Background" Value="#C7CDD6" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style Selector="cc|CompletionList ScrollBar /template/ Track /template/ RepeatButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
</Styles>
