<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Weftline.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="Weftline.App.Views.BottomPanelView"
             x:DataType="vm:MainWindowViewModel">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <TabControl>
        <TabItem Header="问题">
            <ListBox ItemsSource="{Binding Problems}"
                     Background="Transparent"
                     BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProblemViewModel">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto"
                              Margin="8,4">
                            <TextBlock Text="{Binding SeverityLabel}"
                                       Foreground="{Binding SeverityBrush}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Code}"
                                       Margin="10,0"
                                       FontFamily="Cascadia Code, monospace"
                                       Foreground="#808080"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Message}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3"
                                       Text="{Binding Location}"
                                       Margin="16,0,0,0"
                                       Foreground="#808080"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </TabItem>

        <TabItem Header="输出">
            <TextBlock Margin="12"
                       Text="Phase 0：静态界面。打开文件夹、保存、校验和同步将在后续阶段接入。"
                       Foreground="#808080" />
        </TabItem>

        <TabItem Header="检查器">
            <TextBlock Margin="12"
                       Text="选择模块或符号后，在这里查看详情。"
                       Foreground="#808080" />
        </TabItem>
    </TabControl>
</UserControl>
