<suki:SukiWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:suki="https://github.com/kikipoulet/SukiUI"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="Weftline.App.Views.MainWindow"
        xmlns:views="using:Weftline.App.Views"
        xmlns:editor="using:Weftline.Editor.Views"
        xmlns:vm="using:Weftline.App.ViewModels"
        xmlns:graph="using:Weftline.Graph.Controls"
        x:DataType="vm:MainWindowViewModel"
        x:CompileBindings="True"
        Title="Weftline"
        Width="1440"
        Height="900"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <suki:SukiWindow.KeyBindings>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    </suki:SukiWindow.KeyBindings>

    <Grid RowDefinitions="Auto,*,Auto,Auto">
        <views:MainMenuView Grid.Row="0" Height="25" Padding="3"/>

        <Grid Grid.Row="1"
              Background="#F2F3F5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="180" MaxWidth="520" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="520" MinWidth="300" MaxWidth="900" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="6,6,0,6"
                    Background="#FFFFFF"
                    BorderBrush="#E2E5EA"
                    BorderThickness="1"
                    CornerRadius="8"
                    ClipToBounds="True">
                <views:ProjectExplorerView x:Name="Explorer"
                                              DataContext="{Binding Explorer}" />
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="6"
                          ResizeDirection="Columns"
                          Background="Transparent" />

            <Border Grid.Column="2"
                    Margin="0,6,0,6"
                    Background="#FFFFFF"
                    BorderBrush="#E2E5EA"
                    BorderThickness="1"
                    CornerRadius="8"
                    ClipToBounds="True">
                <editor:WeftEditorView x:Name="Editor"
                                       DataContext="{Binding Editor}" />
            </Border>

            <GridSplitter Grid.Column="3"
                          Width="6"
                          ResizeDirection="Columns"
                          Background="Transparent" />

            <Border Grid.Column="4"
                    Margin="0,6,6,6"
                    Background="#F6F8FC"
                    BorderBrush="#E2E5EA"
                    BorderThickness="1"
                    CornerRadius="8"
                    ClipToBounds="True">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0"
                          ColumnDefinitions="*,Auto,Auto"
                          Margin="12,8">
                        <StackPanel Spacing="2">
                            <TextBlock Text="剧情图"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#2B3038" />
                            <TextBlock Text="{Binding Graph.StatusText}"
                                       FontSize="12"
                                       Foreground="#5F6B7A" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="{Binding Graph.FilterButtonText}"
                                Padding="10,4"
                                Margin="0,0,6,0">
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <ScrollViewer MaxHeight="420">
                                        <StackPanel Width="240" Spacing="10">
                                            <TextBlock Text="筛选"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="#2B3038" />
                                            <TextBlock Text="同维度 OR，跨维度 AND"
                                                       FontSize="11"
                                                       Foreground="#5F6B7A" />
                                            <TextBlock Text="角色"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#3F4A59" />
                                            <ItemsControl ItemsSource="{Binding Graph.CharacterOptions}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:GraphFilterOption">
                                                        <CheckBox Content="{Binding Name}"
                                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                  FontSize="12" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="场景"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#3F4A59" />
                                            <ItemsControl ItemsSource="{Binding Graph.SceneOptions}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:GraphFilterOption">
                                                        <CheckBox Content="{Binding Name}"
                                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                  FontSize="12" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="变量"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#3F4A59" />
                                            <ItemsControl ItemsSource="{Binding Graph.VariableOptions}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:GraphFilterOption">
                                                        <CheckBox Content="{Binding Name}"
                                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                  FontSize="12" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button Content="清除筛选"
                                                    Command="{Binding Graph.ClearFilterCommand}"
                                                    HorizontalAlignment="Right"
                                                    Padding="10,3" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button Grid.Column="2"
                                Content="重置布局"
                                Padding="10,4"
                                Click="OnResetGraphLayout" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <graph:StoryGraphView x:Name="GraphView"
                                                  Projection="{Binding Graph.Projection}"
                                                  Filter="{Binding Graph.Filter}" />
                        </ScrollViewer>

                        <Border IsVisible="{Binding Graph.IsHoverSummaryVisible}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                Margin="12"
                                MaxWidth="360"
                                Padding="10,8"
                                Background="#FFFFFF"
                                BorderBrush="#D8DCE3"
                                BorderThickness="1"
                                CornerRadius="8"
                                IsHitTestVisible="False">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding Graph.HoverTitle}"
                                           FontWeight="SemiBold"
                                           Foreground="#2B3038"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Graph.HoverFirstLine}"
                                           IsVisible="{Binding Graph.HasHoverFirstLine}"
                                           FontStyle="Italic"
                                           Foreground="#3F4A59"
                                           TextWrapping="Wrap"
                                           MaxLines="3" />
                                <TextBlock Text="{Binding Graph.HoverMeta}"
                                           FontSize="12"
                                           Foreground="#5F6B7A" />
                                <TextBlock Text="{Binding Graph.HoverDescription}"
                                           IsVisible="{Binding Graph.HasHoverDescription}"
                                           FontSize="12"
                                           Foreground="#5F6B7A"
                                           TextWrapping="Wrap"
                                           MaxLines="4" />
                            </StackPanel>
                        </Border>

                        <Border IsVisible="{Binding Graph.IsChapterEdgeDetailsVisible}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="12"
                                MaxWidth="380"
                                Background="#FFFFFF"
                                BorderBrush="#D8DCE3"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid RowDefinitions="Auto,*">
                                <Grid Grid.Row="0"
                                      ColumnDefinitions="*,Auto"
                                      Margin="10,8,8,4">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Graph.ChapterEdgeTitle}"
                                                   FontWeight="SemiBold"
                                                   Foreground="#2B3038"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Graph.ChapterEdgeSubtitle}"
                                                   FontSize="12"
                                                   Foreground="#5F6B7A" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="×"
                                            Command="{Binding Graph.CloseChapterEdgeDetailsCommand}"
                                            Width="24"
                                            Height="24"
                                            Padding="0"
                                            FontSize="13"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="#5F6B7A"
                                            Focusable="False" />
                                </Grid>

                                <ScrollViewer Grid.Row="1"
                                              MaxHeight="180"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Graph.ChapterEdgeDetails}"
                                                  Margin="10,0,10,10">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ChapterEdgeDetailItem">
                                                <TextBlock Text="{Binding Text}"
                                                           FontSize="12"
                                                           Foreground="#3F4A59"
                                                           TextWrapping="Wrap"
                                                           Margin="0,1" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                IsVisible="{Binding IsProblemsVisible}"
                Height="180"
                Background="#FFFFFF"
                BorderBrush="#E2E5EA"
                BorderThickness="0,1,0,0">
            <Grid RowDefinitions="Auto,*">
                <Grid Grid.Row="0"
                      ColumnDefinitions="*,Auto"
                      Margin="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="问题"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#2B3038"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Diagnostics.Count}"
                                   FontSize="12"
                                   Foreground="#5F6B7A"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="条"
                                   FontSize="12"
                                   Foreground="#5F6B7A"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="×"
                            Command="{Binding ShowProblemsCommand}"
                            Width="24"
                            Height="24"
                            Padding="0"
                            FontSize="13"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#5F6B7A"
                            Focusable="False" />
                </Grid>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Diagnostics}"
                         SelectedItem="{Binding SelectedDiagnostic, Mode=TwoWay}"
                         DoubleTapped="OnDiagnosticDoubleTapped"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="4">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:DiagnosticItem">
                            <Grid ColumnDefinitions="60,70,140,*"
                                  Margin="2">
                                <TextBlock Text="{Binding Severity}"
                                            FontSize="12"
                                            Foreground="#C65B5B" />
                                <TextBlock Grid.Column="1"
                                            Text="{Binding Code}"
                                            FontSize="12"
                                            Foreground="#5F6B7A" />
                                <TextBlock Grid.Column="2"
                                            Text="{Binding Location}"
                                            FontSize="12"
                                            Foreground="#2B3038" />
                                <TextBlock Grid.Column="3"
                                            Text="{Binding Message}"
                                            FontSize="12"
                                            Foreground="#2B3038"
                                            TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <views:StatusBarView Grid.Row="3" DataContext="{Binding Status}" />
    </Grid>
</suki:SukiWindow>
