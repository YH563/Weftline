<suki:SukiWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:suki="https://github.com/kikipoulet/SukiUI"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="Weftline.App.Views.MainWindow"
        xmlns:views="using:Weftline.App.Views"
        xmlns:editor="using:Weftline.Editor.Views"
        xmlns:vm="using:Weftline.App.ViewModels"
        xmlns:graph="using:Weftline.Graph.Controls"
        xmlns:primitives="using:Avalonia.Controls.Primitives"
        x:DataType="vm:MainWindowViewModel"
        x:CompileBindings="True"
        Title="Weftline"
        Width="1440"
        Height="900"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <suki:SukiWindow.KeyBindings>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    </suki:SukiWindow.KeyBindings>

    <Grid RowDefinitions="Auto,*,Auto,Auto">
        <views:MainMenuView Grid.Row="0" />

        <Grid Grid.Row="1"
              Background="{DynamicResource AppBackground}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="180" MaxWidth="520" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="520" MinWidth="300" MaxWidth="900" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Classes="panel"
                    Margin="8,4,0,6"
                    ClipToBounds="True">
                <views:ProjectExplorerView x:Name="Explorer"
                                              DataContext="{Binding Explorer}" />
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="6"
                          ResizeDirection="Columns"
                          Background="Transparent" />

            <Border Grid.Column="2"
                    Classes="panel"
                    Margin="0,4,0,6"
                    ClipToBounds="True">
                <editor:WeftEditorView x:Name="Editor"
                                       DataContext="{Binding Editor}" />
            </Border>

            <GridSplitter Grid.Column="3"
                          Width="6"
                          ResizeDirection="Columns"
                          Background="Transparent" />

            <Border Grid.Column="4"
                    Classes="panel"
                    Margin="0,4,8,6"
                    Background="{DynamicResource SurfaceAlt}"
                    ClipToBounds="True">
                <Grid x:Name="RightPaneGrid"
                      RowDefinitions="Auto,*,6,*">
                    <Grid Grid.Row="0"
                          ColumnDefinitions="Auto,Auto,*"
                          Margin="10,8,10,4">
                        <ToggleButton Classes="paneToggle"
                                      Content="剧情图"
                                      IsChecked="{Binding IsGraphVisible, Mode=TwoWay}" />
                        <ToggleButton Grid.Column="1"
                                      Classes="paneToggle"
                                      Content="预览"
                                      IsChecked="{Binding IsPreviewVisible, Mode=TwoWay}"
                                      Margin="6,0,0,0" />
                    </Grid>

                    <Grid x:Name="GraphPane"
                          Grid.Row="1"
                          RowDefinitions="Auto,*"
                          IsVisible="{Binding IsGraphVisible}">
                    <Grid Grid.Row="0"
                          ColumnDefinitions="*,Auto,Auto"
                          Margin="12,8">
                        <StackPanel Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource IconGraph}"
                                          Width="14"
                                          Height="14"
                                          Foreground="{DynamicResource TextSecondary}"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="剧情图"
                                           Classes="panelTitle" />
                            </StackPanel>
                            <TextBlock Text="{Binding Graph.StatusText}"
                                       Classes="panelSubtitle" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Padding="11,5"
                                Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource IconFilter}"
                                          Width="14"
                                          Height="14"
                                          Foreground="{DynamicResource TextSecondary}"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Graph.FilterButtonText}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <ScrollViewer MaxHeight="420">
                                        <StackPanel Width="240" Spacing="10">
                                            <TextBlock Text="筛选"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimary}" />
                                            <TextBlock Text="同维度 OR，跨维度 AND"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondary}" />
                                            <TextBlock Text="角色"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondary}" />
                                            <ItemsControl ItemsSource="{Binding Graph.CharacterOptions}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:GraphFilterOption">
                                                        <CheckBox Content="{Binding Name}"
                                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                  FontSize="12" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="场景"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondary}" />
                                            <ItemsControl ItemsSource="{Binding Graph.SceneOptions}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:GraphFilterOption">
                                                        <CheckBox Content="{Binding Name}"
                                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                  FontSize="12" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="变量"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondary}" />
                                            <ItemsControl ItemsSource="{Binding Graph.VariableOptions}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:GraphFilterOption">
                                                        <CheckBox Content="{Binding Name}"
                                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                  FontSize="12" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button Content="清除筛选"
                                                    Command="{Binding Graph.ClearFilterCommand}"
                                                    HorizontalAlignment="Right"
                                                    Padding="10,3" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button Grid.Column="2"
                                Padding="11,5"
                                Click="OnResetGraphLayout">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource IconReset}"
                                          Width="14"
                                          Height="14"
                                          Foreground="{DynamicResource TextSecondary}"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="重置布局"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <graph:StoryGraphView x:Name="GraphView"
                                                  Projection="{Binding Graph.Projection}"
                                                  Filter="{Binding Graph.Filter}" />
                        </ScrollViewer>

                        <Border IsVisible="{Binding Graph.IsHoverSummaryVisible}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                Margin="12"
                                MaxWidth="360"
                                Padding="10,8"
                                Background="{DynamicResource Surface}"
                                BorderBrush="{DynamicResource BorderStrong}"
                                BorderThickness="1"
                                CornerRadius="8"
                                IsHitTestVisible="False">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding Graph.HoverTitle}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Graph.HoverFirstLine}"
                                           IsVisible="{Binding Graph.HasHoverFirstLine}"
                                           FontStyle="Italic"
                                           Foreground="{DynamicResource TextSecondary}"
                                           TextWrapping="Wrap"
                                           MaxLines="3" />
                                <TextBlock Text="{Binding Graph.HoverMeta}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock Text="{Binding Graph.HoverDescription}"
                                           IsVisible="{Binding Graph.HasHoverDescription}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondary}"
                                           TextWrapping="Wrap"
                                           MaxLines="4" />
                            </StackPanel>
                        </Border>

                        <Border IsVisible="{Binding Graph.IsChapterEdgeDetailsVisible}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="12"
                                MaxWidth="380"
                                Background="{DynamicResource Surface}"
                                BorderBrush="{DynamicResource BorderStrong}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid RowDefinitions="Auto,*">
                                <Grid Grid.Row="0"
                                      ColumnDefinitions="*,Auto"
                                      Margin="10,8,8,4">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Graph.ChapterEdgeTitle}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Graph.ChapterEdgeSubtitle}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondary}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Classes="icon"
                                            Command="{Binding Graph.CloseChapterEdgeDetailsCommand}">
                                        <PathIcon Data="{StaticResource IconClose}"
                                                  Width="12"
                                                  Height="12"
                                                  Foreground="{DynamicResource TextSecondary}" />
                                    </Button>
                                </Grid>

                                <ScrollViewer Grid.Row="1"
                                              MaxHeight="180"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Graph.ChapterEdgeDetails}"
                                                  Margin="10,0,10,10">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ChapterEdgeDetailItem">
                                                <TextBlock Text="{Binding Text}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextSecondary}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,1" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                    </Grid>

                    <GridSplitter x:Name="PaneSplitter"
                                  Grid.Row="2"
                                  Height="6"
                                  HorizontalAlignment="Stretch"
                                  ResizeDirection="Rows"
                                  Background="Transparent" />

                    <Grid x:Name="PreviewPane"
                          Grid.Row="3"
                          IsVisible="{Binding IsPreviewVisible}">
                        <views:PreviewPanelView DataContext="{Binding Preview}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                IsVisible="{Binding IsProblemsVisible}"
                Height="180"
                Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="0,1,0,0">
            <Grid RowDefinitions="Auto,*">
                <Grid Grid.Row="0"
                      ColumnDefinitions="*,Auto"
                      Margin="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource IconWarning}"
                                  Width="14"
                                  Height="14"
                                  Foreground="{DynamicResource Warning}"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="问题"
                                   Classes="panelTitle"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Diagnostics.Count}"
                                   Classes="panelSubtitle"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="条"
                                   Classes="caption"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Classes="icon"
                            Command="{Binding ShowProblemsCommand}">
                        <PathIcon Data="{StaticResource IconClose}"
                                  Width="12"
                                  Height="12"
                                  Foreground="{DynamicResource TextSecondary}" />
                    </Button>
                </Grid>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Diagnostics}"
                         SelectedItem="{Binding SelectedDiagnostic, Mode=TwoWay}"
                         DoubleTapped="OnDiagnosticDoubleTapped"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="4">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:DiagnosticItem">
                            <Grid ColumnDefinitions="24,70,140,*"
                                  Margin="2">
                                <Panel>
                                    <PathIcon Data="{StaticResource IconError}"
                                              IsVisible="{Binding IsError}"
                                              Width="14"
                                              Height="14"
                                              Foreground="{DynamicResource Danger}"
                                              VerticalAlignment="Center" />
                                    <PathIcon Data="{StaticResource IconWarning}"
                                              IsVisible="{Binding IsWarning}"
                                              Width="14"
                                              Height="14"
                                              Foreground="{DynamicResource Warning}"
                                              VerticalAlignment="Center" />
                                    <PathIcon Data="{StaticResource IconInfo}"
                                              IsVisible="{Binding IsInfo}"
                                              Width="14"
                                              Height="14"
                                              Foreground="{DynamicResource Accent}"
                                              VerticalAlignment="Center" />
                                </Panel>
                                <TextBlock Grid.Column="1"
                                            Text="{Binding Code}"
                                            FontSize="12"
                                            Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock Grid.Column="2"
                                            Text="{Binding Location}"
                                            FontSize="12"
                                            Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock Grid.Column="3"
                                            Text="{Binding Message}"
                                            FontSize="12"
                                            Foreground="{DynamicResource TextPrimary}"
                                            TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <views:StatusBarView Grid.Row="3" DataContext="{Binding Status}" />

        <primitives:VisualLayerManager x:Name="LayerManager"
                                       Grid.RowSpan="4"
                                       EnableOverlayLayer="True" />
    </Grid>
</suki:SukiWindow>
