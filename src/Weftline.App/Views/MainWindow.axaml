<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Weftline.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Weftline.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Weftline.App">

    <Design.DataContext>
        <!-- 这里只为 IDE 预览器设置 DataContext。
             运行时的实际 DataContext 在代码中设置（见 App.axaml.cs）。
             This only sets the DataContext for the previewer in an IDE.
             To set the actual DataContext for runtime, set the DataContext property
             in code (look at App.axaml.cs). -->
        <vm:MainViewModel />
    </Design.DataContext>

    <TextBox Text="{Binding Greeting}"
             HorizontalAlignment="Center"
             VerticalAlignment="Center" />

</Window>
