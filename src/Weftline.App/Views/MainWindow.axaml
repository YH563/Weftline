<suki:SukiWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:suki="https://github.com/kikipoulet/SukiUI"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="Weftline.App.Views.MainWindow"
        xmlns:views="using:Weftline.App.Views"
        xmlns:vm="using:Weftline.App.ViewModels"
        x:DataType="vm:MainWindowViewModel"
        x:CompileBindings="True"
        Title="Weftline"
        Width="1440"
        Height="900"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto,*,Auto">
        <views:MainMenuView Grid.Row="0" Height="25" Padding="3"/>

        <Grid Grid.Row="1"
              Background="#F2F3F5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="180" MaxWidth="520" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="400" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="6,6,0,6"
                    Background="#FFFFFF"
                    BorderBrush="#E2E5EA"
                    BorderThickness="1"
                    CornerRadius="8"
                    ClipToBounds="True">
                <views:ProjectExplorerView x:Name="Explorer"
                                              DataContext="{Binding Explorer}" />
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="6"
                          ResizeDirection="Columns"
                          Background="Transparent" />

            <Border Grid.Column="2"
                    Margin="0,6,6,6"
                    Background="#FFFFFF"
                    BorderBrush="#E2E5EA"
                    BorderThickness="1"
                    CornerRadius="8"
                    ClipToBounds="True">
                <views:EditorView x:Name="Editor"
                                      DataContext="{Binding Editor}" />
            </Border>
        </Grid>

        <views:StatusBarView Grid.Row="2" DataContext="{Binding Status}" />
    </Grid>
</suki:SukiWindow>
