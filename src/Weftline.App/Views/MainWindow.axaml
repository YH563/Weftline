<suki:SukiWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:suki="https://github.com/kikipoulet/SukiUI"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="Weftline.App.Views.MainWindow"
        xmlns:views="using:Weftline.App.Views"
        xmlns:vm="using:Weftline.App.ViewModels"
        xmlns:graph="using:Weftline.Graph.Controls"
        x:DataType="vm:MainWindowViewModel"
        x:CompileBindings="True"
        Title="Weftline"
        Width="1440"
        Height="900"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <suki:SukiWindow.KeyBindings>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    </suki:SukiWindow.KeyBindings>

    <Grid RowDefinitions="Auto,*,Auto,Auto">
        <views:MainMenuView Grid.Row="0" Height="25" Padding="3"/>

        <Grid Grid.Row="1"
              Background="#F2F3F5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="180" MaxWidth="520" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="520" MinWidth="300" MaxWidth="900" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="6,6,0,6"
                    Background="#FFFFFF"
                    BorderBrush="#E2E5EA"
                    BorderThickness="1"
                    CornerRadius="8"
                    ClipToBounds="True">
                <views:ProjectExplorerView x:Name="Explorer"
                                              DataContext="{Binding Explorer}" />
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="6"
                          ResizeDirection="Columns"
                          Background="Transparent" />

            <Border Grid.Column="2"
                    Margin="0,6,0,6"
                    Background="#FFFFFF"
                    BorderBrush="#E2E5EA"
                    BorderThickness="1"
                    CornerRadius="8"
                    ClipToBounds="True">
                <views:EditorView x:Name="Editor"
                                      DataContext="{Binding Editor}" />
            </Border>

            <GridSplitter Grid.Column="3"
                          Width="6"
                          ResizeDirection="Columns"
                          Background="Transparent" />

            <Border Grid.Column="4"
                    Margin="0,6,6,6"
                    Background="#F6F8FC"
                    BorderBrush="#E2E5EA"
                    BorderThickness="1"
                    CornerRadius="8"
                    ClipToBounds="True">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0"
                          ColumnDefinitions="*,Auto"
                          Margin="12,8">
                        <StackPanel Spacing="2">
                            <TextBlock Text="剧情图"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#34405A" />
                            <TextBlock Text="{Binding Graph.StatusText}"
                                       FontSize="11"
                                       Foreground="#7B8699" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="重置布局"
                                Padding="10,4"
                                Click="OnResetGraphLayout" />
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <graph:StoryGraphView x:Name="GraphView"
                                              Projection="{Binding Graph.Projection}" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                IsVisible="{Binding IsProblemsVisible}"
                Height="180"
                Background="#FFFFFF"
                BorderBrush="#E2E5EA"
                BorderThickness="0,1,0,0">
            <Grid RowDefinitions="Auto,*">
                <Grid Grid.Row="0"
                      ColumnDefinitions="*,Auto"
                      Margin="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="问题"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#34405A"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Diagnostics.Count}"
                                   FontSize="11"
                                   Foreground="#7B8699"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="条"
                                   FontSize="11"
                                   Foreground="#7B8699"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="×"
                            Command="{Binding ShowProblemsCommand}"
                            Width="24"
                            Height="24"
                            Padding="0"
                            FontSize="12"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#7A8494"
                            Focusable="False" />
                </Grid>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Diagnostics}"
                         SelectedItem="{Binding SelectedDiagnostic, Mode=TwoWay}"
                         DoubleTapped="OnDiagnosticDoubleTapped"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="4">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:DiagnosticItem">
                            <Grid ColumnDefinitions="60,70,140,*"
                                  Margin="2">
                                <TextBlock Text="{Binding Severity}"
                                           FontSize="11"
                                           Foreground="#C65B5B" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Code}"
                                           FontSize="11"
                                           Foreground="#7B8699" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Location}"
                                           FontSize="11"
                                           Foreground="#3B4352" />
                                <TextBlock Grid.Column="3"
                                           Text="{Binding Message}"
                                           FontSize="11"
                                           Foreground="#3B4352"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <views:StatusBarView Grid.Row="3" DataContext="{Binding Status}" />
    </Grid>
</suki:SukiWindow>
