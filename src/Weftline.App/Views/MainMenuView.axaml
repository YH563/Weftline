<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="50"
             x:Class="Weftline.App.Views.MainMenuView"
             x:CompileBindings="False">

    <UserControl.Resources>
        <ControlTheme x:Key="WeftlineTopLevelMenuItem" TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Margin="2,2">
                        <Panel>
                            <ContentPresenter Name="PART_HeaderPresenter"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalContentAlignment="Left"
                                              VerticalContentAlignment="Center"
                                              Content="{TemplateBinding Header}">
                                <ContentPresenter.ContentTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{Binding}"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </ContentPresenter.ContentTemplate>
                            </ContentPresenter>

                            <Popup Name="PART_Popup"
                                   ShouldUseOverlayLayer="False"
                                   PlacementTarget="{Binding $parent[MenuItem]}"
                                   IsLightDismissEnabled="True"
                                   IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}"
                                   Placement="Bottom"
                                   ClipToBounds="True">
                                <Border Background="{DynamicResource Surface}"
                                        BorderBrush="{DynamicResource BorderStrong}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="4">
                                    <ScrollViewer>
                                        <ItemsPresenter Name="PART_ItemsPresenter"
                                                        ItemsPanel="{TemplateBinding ItemsPanel}" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter>

            <Style Selector="^:pointerover /template/ Border#PART_Root">
                <Setter Property="Background" Value="{DynamicResource SurfaceMuted}" />
            </Style>
            <Style Selector="^:open /template/ Border#PART_Root">
                <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="WeftlineMenuTheme"
                      TargetType="Menu">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ItemContainerTheme" Value="{StaticResource WeftlineTopLevelMenuItem}" />
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Height="30"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ItemsPresenter Name="PART_ItemsPresenter"
                                        ItemsPanel="{TemplateBinding ItemsPanel}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="MenuItem">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="10,5" />
        </Style>
    </UserControl.Styles>

    <Border Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="0,0,0,1"
            Padding="4,0">
        <Menu FontSize="13"
              ItemContainerTheme="{StaticResource WeftlineTopLevelMenuItem}">
            <MenuItem Header="文件">
                <MenuItem Header="新建项目…"
                          InputGesture="Ctrl+N"
                          Command="{Binding NewProjectCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconNewFile}" Width="14" Height="14" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="打开项目…"
                          InputGesture="Ctrl+O"
                          Command="{Binding OpenProjectCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconOpen}" Width="14" Height="14" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="保存章节"
                          InputGesture="Ctrl+S"
                          Command="{Binding SaveCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconSave}" Width="14" Height="14" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="保存布局"
                          Command="{Binding SaveLayoutCommand}" />
                <Separator />
                <MenuItem Header="退出"
                          InputGesture="Alt+F4"
                          Command="{Binding ExitCommand}" />
            </MenuItem>

            <MenuItem Header="编辑">
                <MenuItem Header="撤销"
                          InputGesture="Ctrl+Z"
                          Command="{Binding UndoCommand}" />
                <MenuItem Header="重做"
                          InputGesture="Ctrl+Y"
                          Command="{Binding RedoCommand}" />
            </MenuItem>

            <MenuItem Header="视图">
                <MenuItem Header="预览面板"
                          Command="{Binding TogglePreviewPanelCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconPreview}" Width="14" Height="14" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="问题"
                          Command="{Binding ShowProblemsCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconWarning}" Width="14" Height="14" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="输出"
                          Command="{Binding ShowOutputCommand}" />
                <MenuItem Header="项目总览"
                          Command="{Binding ShowProjectInfoCommand}" />
            </MenuItem>

            <MenuItem Header="运行">
                <MenuItem Header="预览"
                          InputGesture="Ctrl+Enter"
                          Command="{Binding PreviewCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconPreview}" Width="14" Height="14" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="从头预览"
                          Command="{Binding PreviewFromStartCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconPlay}" Width="14" Height="14" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="校验项目"
                          InputGesture="Ctrl+Shift+B"
                          Command="{Binding ValidateCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconCheck}" Width="14" Height="14" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="帮助">
                <MenuItem Header="关于 Weftline"
                          Command="{Binding AboutCommand}" />
            </MenuItem>
        </Menu>
    </Border>
</UserControl>
