<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="50"
             x:Class="Weftline.App.Views.MainMenuView"
             x:CompileBindings="False">

    <UserControl.Resources>
        <ControlTheme x:Key="WeftlineTopLevelMenuItem" TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Margin="2,2">
                        <Panel>
                            <ContentPresenter Name="PART_HeaderPresenter"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalContentAlignment="Left"
                                              VerticalContentAlignment="Center"
                                              Content="{TemplateBinding Header}">
                                <ContentPresenter.ContentTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{Binding}"
                                                   FontSize="12"
                                                   FontWeight="Normal"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </ContentPresenter.ContentTemplate>
                            </ContentPresenter>

                            <Popup Name="PART_Popup"
                                   IsLightDismissEnabled="True"
                                   IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}"
                                   Placement="BottomEdgeAlignedLeft"
                                   ClipToBounds="True">
                                <Panel Background="#F5F5F5">
                                    <Border Background="{DynamicResource SukiCardBackground}"
                                            BorderBrush="{DynamicResource SukiMenuBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            ClipToBounds="True">
                                        <Panel Background="{DynamicResource PopupGradientBrush}">
                                            <ScrollViewer>
                                                <ItemsPresenter Name="PART_ItemsPresenter"
                                                                ItemsPanel="{TemplateBinding ItemsPanel}" />
                                            </ScrollViewer>
                                        </Panel>
                                    </Border>
                                </Panel>
                            </Popup>
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter>

            <Style Selector="^:pointerover /template/ Border#PART_Root">
                <Setter Property="Background" Value="#14808080" />
            </Style>
            <Style Selector="^:open /template/ Border#PART_Root">
                <Setter Property="Background" Value="#14808080" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="WeftlineMenuTheme"
                      TargetType="Menu">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ItemContainerTheme" Value="{StaticResource WeftlineTopLevelMenuItem}" />
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Height="32"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ItemsPresenter Name="PART_ItemsPresenter"
                                        ItemsPanel="{TemplateBinding ItemsPanel}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </UserControl.Resources>

    <Border Background="#F2F3F5"
            Padding="3,0">
        <Menu FontSize="13"
              ItemContainerTheme="{StaticResource WeftlineTopLevelMenuItem}">
            <MenuItem Header="文件">
                <MenuItem Header="新建项目…"
                          InputGesture="Ctrl+N"
                          Command="{Binding NewProjectCommand}" />
                <MenuItem Header="打开项目…"
                          InputGesture="Ctrl+O"
                          Command="{Binding OpenProjectCommand}" />
                <Separator />
                <MenuItem Header="保存章节"
                          InputGesture="Ctrl+S"
                          Command="{Binding SaveCommand}" />
                <MenuItem Header="保存布局"
                          Command="{Binding SaveLayoutCommand}" />
                <Separator />
                <MenuItem Header="退出"
                          InputGesture="Alt+F4"
                          Command="{Binding ExitCommand}" />
            </MenuItem>

            <MenuItem Header="编辑">
                <MenuItem Header="撤销"
                          InputGesture="Ctrl+Z"
                          Command="{Binding UndoCommand}" />
                <MenuItem Header="重做"
                          InputGesture="Ctrl+Y"
                          Command="{Binding RedoCommand}" />
            </MenuItem>

            <MenuItem Header="视图">
                <MenuItem Header="问题"
                          Command="{Binding ShowProblemsCommand}" />
                <MenuItem Header="输出"
                          Command="{Binding ShowOutputCommand}" />
                <MenuItem Header="项目总览"
                          Command="{Binding ShowProjectInfoCommand}" />
            </MenuItem>

            <MenuItem Header="运行">
                <MenuItem Header="校验项目"
                          InputGesture="Ctrl+Shift+B"
                          Command="{Binding ValidateCommand}" />
            </MenuItem>

            <MenuItem Header="帮助">
                <MenuItem Header="关于 Weftline"
                          Command="{Binding AboutCommand}" />
            </MenuItem>
        </Menu>
    </Border>
</UserControl>
