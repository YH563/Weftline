<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="50"
             x:Class="Weftline.App.Views.MainMenuView"
             x:CompileBindings="False">

    <Border Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="0,0,0,1"
            Padding="4,0">
        <Grid ColumnDefinitions="*,Auto">
        <Menu Grid.Column="0"
              x:Name="TopMenu"
              FontSize="13"
              ItemContainerTheme="{StaticResource WeftTopLevelMenuItem}">
            <MenuItem Header="文件">
                <MenuItem Header="新建项目…"
                          InputGesture="Ctrl+N"
                          Command="{Binding NewProjectCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconNewFile}" Width="14" Height="14" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="打开项目…"
                          InputGesture="Ctrl+O"
                          Command="{Binding OpenProjectCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconOpen}" Width="14" Height="14" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="保存章节"
                          InputGesture="Ctrl+S"
                          Command="{Binding SaveCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconSave}" Width="14" Height="14" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="保存布局"
                          Command="{Binding SaveLayoutCommand}" />
                <MenuItem Header="生成项目文件"
                          Command="{Binding GenerateProjectFileCommand}" />
                <Separator />
                <MenuItem Header="退出"
                          InputGesture="Alt+F4"
                          Command="{Binding ExitCommand}" />
            </MenuItem>

            <MenuItem Header="编辑">
                <MenuItem Header="撤销"
                          InputGesture="Ctrl+Z"
                          Command="{Binding UndoCommand}" />
                <MenuItem Header="重做"
                          InputGesture="Ctrl+Y"
                          Command="{Binding RedoCommand}" />
            </MenuItem>

            <MenuItem Header="视图">
                <MenuItem Header="预览面板"
                          Command="{Binding TogglePreviewPanelCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconPreview}" Width="14" Height="14" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="问题"
                          Command="{Binding ShowProblemsCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconWarning}" Width="14" Height="14" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="输出"
                          Command="{Binding ShowOutputCommand}" />
                <MenuItem Header="项目总览"
                          Command="{Binding ShowProjectInfoCommand}" />
            </MenuItem>

            <MenuItem Header="运行">
                <MenuItem Header="预览"
                          InputGesture="Ctrl+Enter"
                          Command="{Binding PreviewCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconPreview}" Width="14" Height="14" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="从头预览"
                          Command="{Binding PreviewFromStartCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconPlay}" Width="14" Height="14" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="校验项目"
                          InputGesture="Ctrl+Shift+B"
                          Command="{Binding ValidateCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconCheck}" Width="14" Height="14" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="帮助">
                <MenuItem Header="关于 Weftline"
                          Command="{Binding AboutCommand}" />
            </MenuItem>
        </Menu>
        <Button Grid.Column="1"
                Classes="icon"
                AutomationProperties.Name="编译项目"
                Margin="4,3,6,3"
                VerticalAlignment="Center"
                Command="{Binding CompileProjectCommand}"
                ToolTip.Tip="编译项目">
            <PathIcon Data="{StaticResource IconBuild}"
                      Width="16"
                      Height="16"
                      Foreground="{DynamicResource TextSecondary}" />
        </Button>
        </Grid>
    </Border>
</UserControl>
