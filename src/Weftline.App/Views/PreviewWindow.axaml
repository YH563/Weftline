<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Weftline.App.ViewModels"
        x:Class="Weftline.App.Views.PreviewWindow"
        x:DataType="vm:PreviewViewModel"
        x:CompileBindings="True"
        Title="剧本预览"
        Width="980"
        Height="780"
        MinWidth="720"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}">


    <Window.Styles>
        <Style Selector="Button.preview-choice">
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="Button.preview-choice:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        </Style>
        <Style Selector="Button.preview-toolbar">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="0,0,0,1"
                Padding="28,16">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding ProjectName}"
                               FontSize="12"
                               Foreground="{DynamicResource TextMuted}" />
                    <TextBlock Text="{Binding ChapterTitle}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <TextBlock Text="起点"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMuted}" />
                    <ComboBox ItemsSource="{Binding StartModules}"
                              SelectedItem="{Binding SelectedStartModule, Mode=TwoWay}"
                              Width="160"
                              FontSize="12" />
                    <Button Classes="preview-toolbar"
                            Content="重开"
                            Command="{Binding RestartFromSelectedCommand}" />
                    <Button Classes="preview-toolbar"
                            Content="关闭"
                            Click="OnCloseClick" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer x:Name="ReaderScroll"
                      Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel MinWidth="640"
                        MaxWidth="780"
                        Margin="28,36,28,48"
                        HorizontalAlignment="Center"
                        Spacing="0">
                <Border x:Name="ReadingArea"
                        Background="Transparent"
                        Cursor="Hand"
                        PointerPressed="OnReadingAreaPointerPressed">
                    <ItemsControl ItemsSource="{Binding VisibleBlocks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PreviewBlockViewModel">
                                <Grid Margin="0,0,0,24">
                                    <Border IsVisible="{Binding IsImage}"
                                            MaxWidth="640"
                                            MaxHeight="380"
                                            MinHeight="160"
                                            HorizontalAlignment="Center"
                                            Background="{DynamicResource SurfaceMuted}"
                                            ClipToBounds="True">
                                        <Panel>
                                            <Image Source="{Binding Image}"
                                                   IsVisible="{Binding HasImage}"
                                                   Stretch="Uniform" />
                                            <TextBlock Text="图片缺失"
                                                       IsVisible="{Binding IsMissingImage}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource TextMuted}" />
                                        </Panel>
                                    </Border>

                                    <StackPanel IsVisible="{Binding IsDialogue}" Spacing="6">
                                        <TextBlock Text="{Binding Speaker}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Accent}" />
                                        <TextBlock Text="{Binding Text}"
                                                   TextWrapping="Wrap"
                                                   FontSize="17"
                                                   LineHeight="30"
                                                   Foreground="{DynamicResource TextPrimary}" />
                                    </StackPanel>

                                    <TextBlock IsVisible="{Binding IsNarration}"
                                               Text="{Binding Text}"
                                               TextWrapping="Wrap"
                                               FontSize="17"
                                               LineHeight="30"
                                               Foreground="{DynamicResource TextPrimary}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <ItemsControl ItemsSource="{Binding Choices}"
                              IsVisible="{Binding HasChoices}"
                              Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PreviewChoiceViewModel">
                            <Button Classes="preview-choice"
                                    Content="{Binding Label}"
                                    Command="{Binding Command}"
                                    Margin="0,0,0,10" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel IsVisible="{Binding IsEnded}"
                            Spacing="14"
                            Margin="0,24,0,0"
                            HorizontalAlignment="Center">
                    <TextBlock Text="故事结束"
                               FontSize="22"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextPrimary}" />
                    <Button Classes="preview-toolbar"
                            Content="重新开始"
                            Command="{Binding RestartCommand}"
                            HorizontalAlignment="Center" />
                </StackPanel>

                <StackPanel IsVisible="{Binding HasError}"
                            Spacing="10"
                            Margin="0,24,0,0">
                    <TextBlock Text="无法继续播放"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Warning}" />
                    <TextBlock Text="{Binding ErrorMessage}"
                               TextWrapping="Wrap"
                               FontSize="14"
                               Foreground="{DynamicResource TextSecondary}" />
                    <Button Classes="preview-toolbar"
                            Content="重新开始"
                            Command="{Binding RestartCommand}"
                            HorizontalAlignment="Left" />
                </StackPanel>

                <TextBlock Text="{Binding HintText}"
                           IsVisible="{Binding CanAdvance}"
                           Margin="0,18,0,0"
                           HorizontalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource TextMuted}" />

                <TextBlock Text="{Binding DebugText}"
                           IsVisible="{Binding IsDebugVisible}"
                           Margin="0,18,0,0"
                           TextWrapping="Wrap"
                           FontSize="11"
                           Foreground="{DynamicResource TextMuted}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
