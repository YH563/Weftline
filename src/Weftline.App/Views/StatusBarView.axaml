<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Weftline.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="24"
             x:Class="Weftline.App.Views.StatusBarView"
             x:DataType="vm:StatusBarViewModel"
             x:CompileBindings="True">

    <Border Height="28"
            Padding="12,0"
            Background="{DynamicResource SurfaceAlt}"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="0,1,0,0">
        <Grid ColumnDefinitions="Auto,*,Auto">
            <StackPanel Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding CaretText}"
                           IsVisible="{Binding HasDocument}"
                           Classes="caption" />
                <Border Width="1" Height="11"
                        IsVisible="{Binding HasDocument}"
                        Background="{DynamicResource Border}" />
                <TextBlock Text="{Binding SelectionText}"
                           IsVisible="{Binding HasSelection}"
                           Classes="caption" />
                <Border Width="1" Height="11"
                        IsVisible="{Binding HasSelection}"
                        Background="{DynamicResource Border}" />
                <TextBlock Text="{Binding Language}"
                           IsVisible="{Binding HasDocument}"
                           Classes="caption" />
                <Border Width="1" Height="11"
                        IsVisible="{Binding HasDocument}"
                        Background="{DynamicResource Border}" />
                <TextBlock Text="{Binding ContextText}"
                           Classes="caption"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="320" />
            </StackPanel>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right">
                <TextBlock Text="{Binding SymbolText}"
                           Classes="caption" />
                <Border Width="1" Height="11"
                        Background="{DynamicResource Border}" />
                <TextBlock Text="{Binding DiagnosticsText}"
                           Classes="caption" />
                <Border Width="1" Height="11"
                        Background="{DynamicResource Border}" />
                <TextBlock Text="{Binding StatusText}"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondary}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
