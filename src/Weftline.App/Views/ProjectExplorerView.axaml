<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Weftline.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="600"
             x:Class="Weftline.App.Views.ProjectExplorerView"
             x:DataType="vm:ProjectExplorerViewModel"
             x:CompileBindings="True">

    <UserControl.Resources>
        <ControlTheme x:Key="WeftlineChevronButton"
                      TargetType="Button">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="Transparent"
                            Width="16"
                            Height="16">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>


    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*">
        <Border Padding="12,10"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource Border}">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4" ToolTip.Tip="{Binding RootPath}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource IconNewFolder}"
                                  Width="14"
                                  Height="14"
                                  Foreground="{DynamicResource TextSecondary}"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="项目资源管理器"
                                   Classes="panelTitle" />
                    </StackPanel>
                    <TextBlock Text="{Binding RootName}"
                               Classes="panelSubtitle"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="2"
                            VerticalAlignment="Center">
                    <Button Classes="icon"
                            Command="{Binding NewFileCommand}"
                            ToolTip.Tip="新建文件">
                        <PathIcon Width="15"
                                  Height="15"
                                  Foreground="{DynamicResource TextSecondary}"
                                  Data="{StaticResource IconNewFile}" />
                    </Button>
                    <Button Classes="icon"
                            Command="{Binding NewFolderCommand}"
                            ToolTip.Tip="新建文件夹">
                        <PathIcon Width="15"
                                  Height="15"
                                  Foreground="{DynamicResource TextSecondary}"
                                  Data="{StaticResource IconNewFolder}" />
                    </Button>
                    <Button Classes="icon"
                            Command="{Binding RenameCommand}"
                            IsEnabled="{Binding HasSelection}"
                            ToolTip.Tip="重命名">
                        <PathIcon Width="15"
                                  Height="15"
                                  Foreground="{DynamicResource TextSecondary}"
                                  Data="{StaticResource IconRename}" />
                    </Button>
                    <Button Classes="icon"
                            Command="{Binding DeleteCommand}"
                            IsEnabled="{Binding HasSelection}"
                            ToolTip.Tip="删除">
                        <PathIcon Width="15"
                                  Height="15"
                                  Foreground="{DynamicResource TextSecondary}"
                                  Data="{StaticResource IconDelete}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ListBox Grid.Row="1"
                 Margin="6,4,6,8"
                 ItemsSource="{Binding VisibleNodes}"
                 SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                 SelectionMode="Single"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.AllowAutoHide="True"
                 FontSize="13"
                 DoubleTapped="OnListDoubleTapped">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="MinHeight" Value="26" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Template">
                        <ControlTemplate>
                            <Border Name="PART_Row"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="0"
                                    MinHeight="26">
                                <Grid ColumnDefinitions="2,*">
                                    <Border Name="PART_Accent"
                                            Width="2"
                                            Margin="0,4"
                                            CornerRadius="1"
                                            Background="Transparent" />
                                    <ContentPresenter Grid.Column="1"
                                                      Name="PART_ContentPresenter"
                                                      Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter>
                </Style>
                <Style Selector="ListBoxItem:pointerover /template/ Border#PART_Row">
                    <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
                </Style>
                <Style Selector="ListBoxItem:selected /template/ Border#PART_Row">
                    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                </Style>
                <Style Selector="ListBoxItem:selected:pointerover /template/ Border#PART_Row">
                    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                </Style>
                <Style Selector="ListBoxItem:selected /template/ Border#PART_Accent">
                    <Setter Property="Background" Value="{DynamicResource Accent}" />
                </Style>
                <Style Selector="ListBox ScrollBar">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="Transitions">
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                        </Transitions>
                    </Setter>
                </Style>
                <Style Selector="ListBox:pointerover ScrollBar">
                    <Setter Property="Opacity" Value="1" />
                </Style>
                <Style Selector="ScrollBar:pointerover">
                    <Setter Property="Opacity" Value="1" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ProjectTreeNodeViewModel">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,*"
                          Height="26"
                          HorizontalAlignment="Stretch">
                        <Border Width="{Binding Indent}" />

                        <Grid Grid.Column="1"
                              Width="16"
                              Height="16"
                              VerticalAlignment="Center">
                            <Button Theme="{StaticResource WeftlineChevronButton}"
                                    Command="{Binding ToggleExpandCommand}"
                                    IsVisible="{Binding CanExpand}">
                                <Path Data="M 0,0 L 4,4 L 0,8"
                                      Width="8"
                                      Height="8"
                                      Stretch="Uniform"
                                      Stroke="{DynamicResource TextMuted}"
                                      StrokeThickness="1.2"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      RenderTransformOrigin="50%,50%">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="{Binding ChevronAngle}" />
                                    </Path.RenderTransform>
                                </Path>
                            </Button>
                        </Grid>

                        <PathIcon Grid.Column="2"
                                  Data="{Binding IconGeometry}"
                                  Foreground="{Binding IconBrush}"
                                  Width="16"
                                  Height="16"
                                  Margin="6,0,6,0"
                                  VerticalAlignment="Center" />

                        <TextBlock Grid.Column="3"
                                   Text="{Binding Name}"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
