<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Weftline.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="600"
             x:Class="Weftline.App.Views.ProjectExplorerView"
             x:DataType="vm:ProjectExplorerViewModel"
             x:CompileBindings="True">

    <Grid RowDefinitions="Auto,*">
        <Border Padding="12,10"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource Border}">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4" ToolTip.Tip="{Binding RootPath}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource IconNewFolder}"
                                  Width="14"
                                  Height="14"
                                  Foreground="{DynamicResource TextSecondary}"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="项目资源管理器"
                                   Classes="panelTitle" />
                    </StackPanel>
                    <TextBlock Text="{Binding RootName}"
                               Classes="panelSubtitle"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="2"
                            VerticalAlignment="Center">
                    <Button Classes="icon"
                            AutomationProperties.Name="新建文件"
                            Command="{Binding NewFileCommand}"
                            ToolTip.Tip="新建文件">
                        <PathIcon Width="15"
                                  Height="15"
                                  Foreground="{DynamicResource TextSecondary}"
                                  Data="{StaticResource IconNewFile}" />
                    </Button>
                    <Button Classes="icon"
                            AutomationProperties.Name="新建文件夹"
                            Command="{Binding NewFolderCommand}"
                            ToolTip.Tip="新建文件夹">
                        <PathIcon Width="15"
                                  Height="15"
                                  Foreground="{DynamicResource TextSecondary}"
                                  Data="{StaticResource IconNewFolder}" />
                    </Button>
                    <Button Classes="icon"
                            AutomationProperties.Name="重命名"
                            Command="{Binding RenameCommand}"
                            IsEnabled="{Binding HasSelection}"
                            ToolTip.Tip="重命名">
                        <PathIcon Width="15"
                                  Height="15"
                                  Foreground="{DynamicResource TextSecondary}"
                                  Data="{StaticResource IconRename}" />
                    </Button>
                    <Button Classes="icon"
                            AutomationProperties.Name="删除"
                            Command="{Binding DeleteCommand}"
                            IsEnabled="{Binding HasSelection}"
                            ToolTip.Tip="删除">
                        <PathIcon Width="15"
                                  Height="15"
                                  Foreground="{DynamicResource TextSecondary}"
                                  Data="{StaticResource IconDelete}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ListBox Grid.Row="1"
                 Margin="6,4,6,8"
                 ItemsSource="{Binding VisibleNodes}"
                 SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                 Classes="explorer"
                 ItemContainerTheme="{StaticResource WeftExplorerItem}"
                 SelectionMode="Single"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.AllowAutoHide="True"
                 FontSize="13"
                 DoubleTapped="OnListDoubleTapped">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ProjectTreeNodeViewModel">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,*"
                          Height="26"
                          HorizontalAlignment="Stretch">
                        <Border Width="{Binding Indent}" />

                        <Grid Grid.Column="1"
                              Width="16"
                              Height="16"
                              VerticalAlignment="Center">
                            <Button Theme="{StaticResource WeftChevronButton}"
                                    Command="{Binding ToggleExpandCommand}"
                                    IsVisible="{Binding CanExpand}">
                                <Path Data="M 0,0 L 4,4 L 0,8"
                                      Width="8"
                                      Height="8"
                                      Stretch="Uniform"
                                      Stroke="{DynamicResource TextMuted}"
                                      StrokeThickness="1.2"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      RenderTransformOrigin="50%,50%">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="{Binding ChevronAngle}" />
                                    </Path.RenderTransform>
                                </Path>
                            </Button>
                        </Grid>

                        <PathIcon Grid.Column="2"
                                  Data="{Binding IconGeometry}"
                                  Foreground="{Binding IconBrush}"
                                  Width="16"
                                  Height="16"
                                  Margin="6,0,6,0"
                                  VerticalAlignment="Center" />

                        <TextBlock Grid.Column="3"
                                   Text="{Binding Name}"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
