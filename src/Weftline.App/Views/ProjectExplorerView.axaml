<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Weftline.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="Weftline.App.Views.ProjectExplorerView"
             x:DataType="vm:ProjectExplorerViewModel">

    <Grid RowDefinitions="Auto,*">
        <StackPanel Margin="16,16,16,8" Spacing="2">
            <TextBlock Text="项目" FontSize="12" Foreground="#808080" />
            <TextBlock Text="{Binding ProjectName}" FontSize="16" FontWeight="SemiBold" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="8,0,8,8">
            <StackPanel Spacing="6">
                <ItemsControl ItemsSource="{Binding Chapters}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChapterNodeViewModel">
                            <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                      Margin="0,0,0,4">
                                <Expander.Header>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                </Expander.Header>
                                <ItemsControl ItemsSource="{Binding Modules}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ModuleNodeViewModel">
                                            <Border Margin="8,2"
                                                    Padding="10,8"
                                                    CornerRadius="6"
                                                    Background="#10808080">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{Binding Id}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Scene}"
                                                               FontSize="12"
                                                               Foreground="#808080" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Separator Margin="8,8" />

                <ItemsControl ItemsSource="{Binding SymbolGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SymbolGroupViewModel">
                            <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                      Margin="0,0,0,4">
                                <Expander.Header>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                </Expander.Header>
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Border Margin="8,2"
                                                    Padding="10,6"
                                                    CornerRadius="6"
                                                    Background="#0C808080">
                                                <TextBlock Text="{Binding}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
