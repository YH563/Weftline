<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Weftline.App.ViewModels"
             xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="Weftline.App.Views.EditorView"
             x:DataType="vm:DocumentViewModel">

    <Design.DataContext>
        <vm:DocumentViewModel Title="第一章 雨夜.weft"
                              FilePath="samples/believe.weft"
                              Text="[雨夜。]" />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">
        <Border Padding="12,6"
                BorderThickness="0,0,0,1"
                BorderBrush="#22808080">
            <TextBlock Text="{Binding FilePath}"
                       FontSize="12"
                       Foreground="#808080" />
        </Border>

        <ae:TextEditor x:Name="Editor"
                       Grid.Row="1"
                       ShowLineNumbers="True"
                       FontSize="14"
                       FontFamily="Cascadia Code, JetBrains Mono, Consolas, monospace"
                       HorizontalScrollBarVisibility="Auto"
                       VerticalScrollBarVisibility="Auto" />
    </Grid>
</UserControl>
