<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Weftline.App.App"
             RequestedThemeVariant="Light">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Weftline.App/Assets/Icons.axaml" />
                <ResourceInclude Source="avares://Weftline.Widgets/Themes/WeftlineTheme.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <SimpleTheme />

        <StyleInclude Source="avares://AvaloniaEdit/Themes/Simple/AvaloniaEdit.xaml" />
        <StyleInclude Source="avares://Weftline.App/Features/Editor/Themes/EditorStyles.axaml" />
        <StyleInclude Source="avares://Weftline.Widgets/Themes/WeftlineStyles.axaml" />
    </Application.Styles>
</Application>
