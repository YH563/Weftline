<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Weftline.App.Features.Player.ViewModels"
             xmlns:controls="using:Weftline.App.Controls"
             x:Class="Weftline.App.Features.Player.Views.PreviewPanelView"
             x:DataType="vm:PreviewPanelViewModel"
             x:CompileBindings="True">

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                Padding="12,8"
                Background="{DynamicResource SurfaceAlt}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="0,0,0,1">
            <TextBlock Text="{Binding ChapterTitle}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"
                       TextTrimming="CharacterEllipsis" />
        </Border>

        <Grid Grid.Row="1">
            <ScrollViewer x:Name="PreviewScroll"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          AllowAutoHide="True">
                <ItemsControl x:Name="ModuleList"
                              ItemsSource="{Binding Modules}"
                              Margin="28,22,28,36">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PreviewModuleViewModel">
                            <Grid Margin="0,0,0,30">
                                <Border IsVisible="{Binding !IsEnd}"
                                        Classes="moduleRail"
                                        Classes.current="{Binding IsCurrent}"
                                        PointerPressed="OnModulePointerPressed">
                                    <StackPanel Spacing="8">
                                        <Border Height="1"
                                                Background="{DynamicResource Border}"
                                                Margin="0,0,0,4" />
                                        <Button Classes="link"
                                                Command="{Binding OpenCommand}"
                                                Click="OnModuleTitleClick"
                                                HorizontalAlignment="Left"
                                                Foreground="{DynamicResource TextPrimary}"
                                                ToolTip.Tip="跳转到模块源码">
                                            <TextBlock Text="{Binding ModuleId}"
                                                       FontSize="18"
                                                       FontWeight="Bold"
                                                       TextAlignment="Left"
                                                       TextWrapping="Wrap" />
                                        </Button>

                                        <ItemsControl ItemsSource="{Binding Lines}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:PreviewLineViewModel">
                                                    <Grid>
                                                        <TextBlock IsVisible="{Binding IsScene}"
                                                                   Text="{Binding SceneText}"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,10,0,6"
                                                                   FontSize="12"
                                                                   FontStyle="Italic"
                                                                   Foreground="{DynamicResource TextMuted}" />

                                                        <TextBlock IsVisible="{Binding IsNarration}"
                                                                   Text="{Binding Text}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="24,4,24,4"
                                                                   FontSize="14"
                                                                   LineHeight="24"
                                                                   Foreground="{DynamicResource TextPrimary}" />

                                                        <TextBlock IsVisible="{Binding IsDialogue}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="24,6"
                                                                   FontSize="14"
                                                                   LineHeight="24"
                                                                   Foreground="{DynamicResource TextPrimary}">
                                                            <Run Text="{Binding Speaker}" FontWeight="Bold" />
                                                            <Run Text="：" />
                                                            <Run Text="{Binding Text}" />
                                                        </TextBlock>

                                                        <Panel IsVisible="{Binding IsImage}"
                                                               MaxWidth="300"
                                                               MaxHeight="200"
                                                               MinWidth="220"
                                                               MinHeight="80"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,8,0,8">
                                                            <controls:RoundedImage Source="{Binding Image}"
                                                                                   CornerRadius="6"
                                                                                   Background="{DynamicResource SurfaceMuted}"
                                                                                   HorizontalAlignment="Stretch"
                                                                                   VerticalAlignment="Stretch" />
                                                            <TextBlock Text="图片缺失"
                                                                       IsVisible="{Binding IsMissingImage}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="12"
                                                                       Foreground="{DynamicResource TextMuted}" />
                                                        </Panel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <StackPanel IsVisible="{Binding HasChoices}"
                                                    Spacing="6"
                                                    Margin="0,14,0,0">
                                            <Border Width="32"
                                                    Height="1"
                                                    HorizontalAlignment="Center"
                                                    Background="{DynamicResource Border}"
                                                    Margin="0,2,0,2" />
                                            <TextBlock Text="{Binding ChoicePrompt}"
                                                       Margin="24,0,0,0"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimary}" />
                                            <ItemsControl ItemsSource="{Binding Choices}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:PreviewBranchViewModel">
                                                        <Button Theme="{StaticResource WeftChoiceTextButton}"
                                                                Command="{Binding OpenCommand}"
                                                                HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Stretch"
                                                                Margin="0,2"
                                                                ToolTip.Tip="跳转到对应模块">
                                                            <TextBlock Text="{Binding DisplayLabel}"
                                                                       FontSize="14"
                                                                       TextAlignment="Center"
                                                                       TextDecorations="Underline"
                                                                       TextWrapping="Wrap" />
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <TextBlock Text="{Binding AutoExitText}"
                                                   IsVisible="{Binding HasAutoExit}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,10,0,2"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextMuted}" />
                                    </StackPanel>
                                </Border>

                                <StackPanel IsVisible="{Binding IsEnd}"
                                            HorizontalAlignment="Center"
                                            Spacing="10"
                                            Margin="0,8,0,0">
                                    <Border Width="120"
                                            Height="1"
                                            HorizontalAlignment="Center"
                                            Background="{DynamicResource Border}" />
                                    <TextBlock Text="END"
                                               HorizontalAlignment="Center"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextMuted}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel IsVisible="{Binding IsEmpty}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10"
                        Margin="24">
                <PathIcon Data="{StaticResource IconPreview}"
                          Width="36"
                          Height="36"
                          Foreground="{DynamicResource TextMuted}"
                          HorizontalAlignment="Center" />
                <TextBlock Text="{Binding EmptyMessage}"
                           FontSize="13"
                           Foreground="{DynamicResource TextMuted}"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />
            </StackPanel>

            <Border Classes="banner"
                    IsVisible="{Binding IsStale}"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Stretch"
                    Margin="12,0,12,0">
                <TextBlock Text="内容已更新，当前显示上一次可用预览"
                           FontSize="12"
                           Foreground="{DynamicResource Warning}" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
