<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Weftline.App.Features.Player.ViewModels"
        xmlns:controls="using:Weftline.App.Controls"
        x:Class="Weftline.App.Features.Player.Views.PreviewWindow"
        x:DataType="vm:PreviewViewModel"
        x:CompileBindings="True"
        Title="剧本预览"
        Width="980"
        Height="780"
        MinWidth="720"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}">

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="0,0,0,1"
                Padding="28,16">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding ProjectName}"
                               FontSize="12"
                               Foreground="{DynamicResource TextMuted}" />
                    <TextBlock Text="{Binding ChapterTitle}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <TextBlock Text="起点"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMuted}" />
                    <ComboBox ItemsSource="{Binding StartModules}"
                              SelectedItem="{Binding SelectedStartModule, Mode=TwoWay}"
                              Width="160"
                              FontSize="12" />
                    <Button Classes="toolbar"
                            Content="重开"
                            Command="{Binding RestartFromSelectedCommand}" />
                    <Button Classes="toolbar"
                            Content="关闭"
                            Click="OnCloseClick" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer x:Name="ReaderScroll"
                      Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel MinWidth="640"
                        MaxWidth="780"
                        Margin="28,36,28,48"
                        HorizontalAlignment="Center"
                        Spacing="0">
                <Border x:Name="ReadingArea"
                        Background="Transparent"
                        Cursor="Hand"
                        PointerPressed="OnReadingAreaPointerPressed">
                    <ItemsControl ItemsSource="{Binding VisibleBlocks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PreviewBlockViewModel">
                                <Grid Margin="0,0,0,24">
                                    <Panel IsVisible="{Binding IsImage}"
                                           MaxWidth="640"
                                           MaxHeight="380"
                                           MinWidth="320"
                                           MinHeight="160"
                                           HorizontalAlignment="Center">
                                        <controls:RoundedImage Source="{Binding Image}"
                                                               Background="{DynamicResource SurfaceMuted}"
                                                               HorizontalAlignment="Stretch"
                                                               VerticalAlignment="Stretch" />
                                        <TextBlock Text="图片缺失"
                                                   IsVisible="{Binding IsMissingImage}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource TextMuted}" />
                                    </Panel>

                                    <TextBlock IsVisible="{Binding IsDialogue}"
                                               TextWrapping="Wrap"
                                               FontSize="17"
                                               LineHeight="30"
                                               Foreground="{DynamicResource TextPrimary}">
                                        <Run Text="{Binding Speaker}" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
                                        <Run Text="：" />
                                        <Run Text="{Binding Text}" />
                                    </TextBlock>

                                    <TextBlock IsVisible="{Binding IsNarration}"
                                               Text="{Binding Text}"
                                               TextWrapping="Wrap"
                                               FontSize="17"
                                               LineHeight="30"
                                               Foreground="{DynamicResource TextPrimary}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <Border IsVisible="{Binding HasChoices}"
                        Height="1"
                        Margin="0,24,0,18"
                        Background="{DynamicResource Border}" />

                <ItemsControl ItemsSource="{Binding Choices}"
                              IsVisible="{Binding HasChoices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PreviewChoiceViewModel">
                            <Button Theme="{StaticResource WeftChoiceTextButton}"
                                    Command="{Binding Command}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Margin="0,4"
                                    ToolTip.Tip="选择这个分支">
                                <TextBlock Text="{Binding DisplayLabel}"
                                           FontSize="17"
                                           TextAlignment="Center"
                                           TextDecorations="Underline"
                                           TextWrapping="Wrap" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel IsVisible="{Binding IsEnded}"
                            Spacing="14"
                            Margin="0,24,0,0"
                            HorizontalAlignment="Center">
                    <TextBlock Text="故事结束"
                               FontSize="22"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextPrimary}" />
                    <Button Classes="toolbar"
                            Content="重新开始"
                            Command="{Binding RestartCommand}"
                            HorizontalAlignment="Center" />
                </StackPanel>

                <StackPanel IsVisible="{Binding HasError}"
                            Spacing="10"
                            Margin="0,24,0,0">
                    <TextBlock Text="无法继续播放"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Warning}" />
                    <TextBlock Text="{Binding ErrorMessage}"
                               TextWrapping="Wrap"
                               FontSize="14"
                               Foreground="{DynamicResource TextSecondary}" />
                    <Button Classes="toolbar"
                            Content="重新开始"
                            Command="{Binding RestartCommand}"
                            HorizontalAlignment="Left" />
                </StackPanel>

                <TextBlock Text="{Binding HintText}"
                           IsVisible="{Binding CanAdvance}"
                           Margin="0,18,0,0"
                           HorizontalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource TextMuted}" />

                <TextBlock Text="{Binding DebugText}"
                           IsVisible="{Binding IsDebugVisible}"
                           Margin="0,18,0,0"
                           TextWrapping="Wrap"
                           FontSize="11"
                           Foreground="{DynamicResource TextMuted}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
