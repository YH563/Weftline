<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!-- 开发期：按平台把 native core 复制到输出目录，正式发布应改为按 RID 打包。 -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)../../native/out/build/release/weftline-core/libweftline_core.so')">
    <None Include="$(MSBuildThisFileDirectory)../../native/out/build/release/weftline-core/libweftline_core.so">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>libweftline_core.so</Link>
    </None>
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) And Exists('$(MSBuildThisFileDirectory)../../native/out/build/release/weftline-core/weftline_core.dll')">
    <None Include="$(MSBuildThisFileDirectory)../../native/out/build/release/weftline-core/weftline_core.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>weftline_core.dll</Link>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.4" />
    <PackageReference Include="SukiUI" Version="7.0.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Weftline.Editor\Weftline.Editor.csproj" />
    <ProjectReference Include="..\Weftline.Graph\Weftline.Graph.csproj" />
    <ProjectReference Include="..\Weftline.Models\Weftline.Models.csproj" />
    <ProjectReference Include="..\Weftline.Native\Weftline.Native.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Views\StatusBarView.axaml.cs">
      <DependentUpon>StatusBarView.axaml</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>
