<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Weftline.Core\Weftline.Core.csproj" />
  </ItemGroup>

  <!--
      开发期：把 native core 动态库复制到输出目录，供 P/Invoke 加载。
      正式发布应改为按 RID 打包原生依赖。
      Dev-time: copy the native core library next to the managed output.
  -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)../../native/out/build/release/weftline-core/libweftline_core.so')">
    <None Include="$(MSBuildThisFileDirectory)../../native/out/build/release/weftline-core/libweftline_core.so">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>libweftline_core.so</Link>
    </None>
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) And Exists('$(MSBuildThisFileDirectory)../../native/out/build/release/weftline-core/weftline_core.dll')">
    <None Include="$(MSBuildThisFileDirectory)../../native/out/build/release/weftline-core/weftline_core.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>weftline_core.dll</Link>
    </None>
  </ItemGroup>

</Project>
