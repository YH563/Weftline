@title 第一章 雨夜

@vars
    @var trust_low false
    @var has_key false

@chars
    @char 萧影
    @char 影子

@items
    @item 医院钥匙

@scenes
    @scene 街道
    @scene 医院

@module 序
    @scene 街道
    [雨夜，{萧影}走向医院。]
@next -> 相信 { @set trust_low true }

@module 相信
    @scene 医院
    [雨水模糊了视线，{萧影}在泥泞中奔跑。]
    萧影:[你来了。]
    影子:[别回头。]
    @fig "assets/hospital.png"
@next(萧影):(trust_low)[相信他] -> 医院 { @set has_key true }
    ()[沉默] -> 沉默

@module 医院
    @scene 医院
    [两人走进医院。]
@next():(has_key) -> 地下层
    () -> 走廊

@module 地下层
    @scene 医院
    [萧影找到了{医院钥匙}。]
@next -> END

@module 走廊
    @scene 医院
    [走廊空无一人。]
@next -> END

@module 沉默
    @scene 医院
    [萧影没有说话。]
@next -> END
