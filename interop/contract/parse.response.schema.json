{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weftline.local/schema/parse.response.schema.json",
  "title": "Weftline core parse response",
  "type": "object",
  "required": [
    "schemaVersion",
    "version",
    "filePath",
    "requestVersion",
    "hasErrors",
    "diagnostics"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "version": {
      "type": "string"
    },
    "filePath": {
      "type": "string"
    },
    "requestVersion": {
      "type": "integer"
    },
    "hasErrors": {
      "type": "boolean"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "message", "start", "length"],
        "properties": {
          "code": {
            "type": "string"
          },
          "severity": {
            "enum": ["info", "warning", "error"]
          },
          "message": {
            "type": "string"
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "length": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "error": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
