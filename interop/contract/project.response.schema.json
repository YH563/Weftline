{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weftline.local/schema/project.response.schema.json",
  "title": "Weftline project compile response",
  "type": "object",
  "required": [
    "schemaVersion",
    "hasErrors",
    "diagnostics",
    "projectName"
  ],
  "properties": {
    "schemaVersion": {
      "const": 4
    },
    "version": {
      "type": "string"
    },
    "hasErrors": {
      "type": "boolean"
    },
    "error": {
      "type": "string"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "severity",
          "message",
          "filePath",
          "start",
          "length"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "info",
              "warning",
              "error"
            ]
          },
          "message": {
            "type": "string"
          },
          "filePath": {
            "type": "string"
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "length": {
            "type": "integer",
            "minimum": 0
          },
          "related": {
            "type": "object",
            "required": [
              "filePath",
              "start",
              "length"
            ],
            "properties": {
              "filePath": {
                "type": "string"
              },
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "length": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "symbols": {
      "type": "object",
      "properties": {
        "variables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/symbol"
          }
        },
        "characters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/symbol"
          }
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/symbol"
          }
        },
        "scenes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/symbol"
          }
        },
        "chapters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/chapter"
          }
        }
      },
      "additionalProperties": false
    },
    "graph": {
      "type": "object",
      "description": "StoryGraph JSON；字段见 docs 或 ir/story_graph.hpp。"
    },
    "wstory": {
      "type": "string",
      "description": "由 .weft 声明生成、保留现有描述的 .wstory 文本；仅在 WEFT_COMPILE_WSTORY 时出现。"
    },
    "projection": {
      "type": "object",
      "description": "GraphProjection JSON；字段见 graph/graph_projection.hpp。"
    },
    "runtime": {
      "$ref": "#/$defs/runtimeProjection"
    },
    "projectName": {
      "type": "string"
    }
  },
  "$defs": {
    "symbol": {
      "type": "object",
      "required": [
        "name",
        "filePath",
        "start",
        "length"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "initial": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "filePath": {
          "type": "string"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "length": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "chapter": {
      "type": "object",
      "required": [
        "id",
        "title",
        "moduleIds",
        "filePath",
        "start",
        "length"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "moduleIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "filePath": {
          "type": "string"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "length": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "runtimeProjection": {
      "type": "object",
      "required": [
        "schemaVersion",
        "projectName",
        "end",
        "chapters",
        "globals",
        "modules"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "projectName": {
          "type": "string"
        },
        "entry": {
          "type": "string"
        },
        "end": {
          "type": "string"
        },
        "chapters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/runtimeChapter"
          }
        },
        "globals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/runtimeGlobal"
          }
        },
        "modules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/runtimeModule"
          }
        }
      },
      "additionalProperties": false
    },
    "runtimeChapter": {
      "type": "object",
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "runtimeGlobal": {
      "type": "object",
      "required": [
        "name",
        "initial"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "initial": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "runtimeModule": {
      "type": "object",
      "required": [
        "id",
        "chapterId",
        "content"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "chapterId": {
          "type": "string"
        },
        "scenes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/runtimeScene"
          }
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/runtimeContent"
          }
        },
        "exit": {
          "$ref": "#/$defs/runtimeExit"
        }
      },
      "additionalProperties": false
    },
    "runtimeScene": {
      "type": "object",
      "required": [
        "name",
        "contentIndex"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "contentIndex": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "runtimeContent": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "narration",
            "dialogue",
            "figure"
          ]
        },
        "segments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/runtimeSegment"
          }
        },
        "speaker": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "runtimeSegment": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "text",
            "ref"
          ]
        },
        "text": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "runtimeExit": {
      "type": "object",
      "required": [
        "mode",
        "branches"
      ],
      "properties": {
        "mode": {
          "enum": [
            "auto",
            "choice"
          ]
        },
        "character": {
          "type": "string"
        },
        "branches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/runtimeBranch"
          }
        }
      },
      "additionalProperties": false
    },
    "runtimeBranch": {
      "type": "object",
      "required": [
        "target",
        "effects"
      ],
      "properties": {
        "condition": {
          "$ref": "#/$defs/runtimeBoolExpr"
        },
        "label": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/runtimeEffect"
          }
        }
      },
      "additionalProperties": false
    },
    "runtimeBoolExpr": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "literal",
            "ref",
            "not",
            "and",
            "or"
          ]
        },
        "value": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "expr": {
          "$ref": "#/$defs/runtimeBoolExpr"
        },
        "left": {
          "$ref": "#/$defs/runtimeBoolExpr"
        },
        "right": {
          "$ref": "#/$defs/runtimeBoolExpr"
        }
      },
      "additionalProperties": false
    },
    "runtimeEffect": {
      "type": "object",
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
