{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weftline.local/schema/project.response.schema.json",
  "title": "Weftline project compile response",
  "type": "object",
  "required": ["schemaVersion", "hasErrors", "diagnostics"],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "version": {
      "type": "string"
    },
    "hasErrors": {
      "type": "boolean"
    },
    "error": {
      "type": "string"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "message", "filePath", "start", "length"],
        "properties": {
          "code": {
            "type": "string"
          },
          "severity": {
            "enum": ["info", "warning", "error"]
          },
          "message": {
            "type": "string"
          },
          "filePath": {
            "type": "string"
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "length": {
            "type": "integer",
            "minimum": 0
          },
          "related": {
            "type": "object",
            "required": ["filePath", "start", "length"],
            "properties": {
              "filePath": {
                "type": "string"
              },
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "length": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "symbols": {
      "type": "object",
      "properties": {
        "variables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/symbol"
          }
        },
        "characters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/symbol"
          }
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/symbol"
          }
        },
        "scenes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/symbol"
          }
        },
        "chapters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/chapter"
          }
        }
      },
      "additionalProperties": false
    },
    "graph": {
      "type": "object",
      "description": "StoryGraph JSON；字段见 docs 或 ir/story_graph.hpp。"
    },
    "projection": {
      "type": "object",
      "description": "GraphProjection JSON；字段见 ir/graph_projection.hpp。"
    },
    "runtime": {
      "type": "object",
      "description": "RuntimeProjection JSON；字段见 runtime.response.schema.json。"
    }
  },
  "$defs": {
    "symbol": {
      "type": "object",
      "required": ["name", "filePath", "start", "length"],
      "properties": {
        "name": {
          "type": "string"
        },
        "initial": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "filePath": {
          "type": "string"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "length": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "chapter": {
      "type": "object",
      "required": ["id", "title", "moduleIds", "filePath", "start", "length"],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "moduleIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "filePath": {
          "type": "string"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "length": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
